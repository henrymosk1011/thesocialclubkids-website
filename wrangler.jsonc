{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thesocialclubkids",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only the contact API runs Worker code; every page and file is served straight from the edge.
    "run_worker_first": ["/api/*"]
  },
  // Stores the cached Instagram feed (and the refreshed token, if one is used). No id on
  // purpose: Wrangler (and Workers Builds) create the namespace on the first deploy.
  "kv_namespaces": [
    { "binding": "INSTAGRAM" }
  ],
  // Mondays 09:17 UTC: keep the feed warm and refresh the Instagram token, if one is used
  // (it expires after 60 days unused).
  "triggers": {
    "crons": ["17 9 * * 1"]
  },
  // Five contact form submissions per minute per IP address.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "4411",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Non secret settings. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, INSTAGRAM_TOKEN) are set in the
  // Cloudflare dashboard or with `npx wrangler secret put NAME`, never committed here.
  "vars": {
    "CONTACT_TO": "contact@thesocialclubkids.com",
    "CONTACT_FROM": "The Social Club Website <website@forms.thesocialclubkids.com>",
    "TURNSTILE_SITE_KEY": "",
    // Instagram feed: the id at the end of the Behold feed URL (https://feeds.behold.so/<id>).
    // Not a secret. Empty means the page shows the built in club photos. See README.
    "BEHOLD_FEED_ID": "",
    "ALLOWED_ORIGINS": "https://www.thesocialclubkids.com,https://thesocialclubkids.com"
  }
}
